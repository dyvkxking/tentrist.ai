# ============================================
# TENTRIST FRONTEND
# ============================================

# Supabase (required - get from supabase.com dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (server-side only - NEVER expose to client)
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Go Backend API (must match PORT in backend/.env)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Site URL (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Blockchain Chain ID (31337 = Hardhat local, 11155111 = Sepolia testnet)
NEXT_PUBLIC_CHAIN_ID=31337

# WalletConnect Project ID (optional - get from cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
