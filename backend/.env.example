# ============================================
# TENTRIST BACKEND
# ============================================

# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# Supabase JWT secret (required - get from Supabase dashboard > Settings > API)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Server port
PORT=8080

# CORS origin (must match NEXT_PUBLIC_SITE_URL in frontend .env)
CORS_ORIGIN=http://localhost:3000

# Escrow smart contract address (required after deployment)
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
