{
  "project": {
    "name": "tentrist",
    "description": "Decentralized SLA-Enforced GPU Orchestration Protocol"
  },
  "permissions": {
    "allow": [
      "Bash:go build ./...",
      "Bash:go test ./...",
      "Bash:npx hardhat test",
      "Bash:npx hardhat compile",
      "Bash:npm run build",
      "Bash:npm run dev",
      "Bash:git *",
      "Bash:ls *",
      "Bash:mkdir *",
      "Bash:rm *",
      "Bash:cd *"
    ]
  },
  "hooks": {
    "preCommand": []
  },
  "env": {
    "NEXT_PUBLIC_API_URL": "http://localhost:8080",
    "NEXT_PUBLIC_WS_URL": "ws://localhost:8080/ws"
  }
}
